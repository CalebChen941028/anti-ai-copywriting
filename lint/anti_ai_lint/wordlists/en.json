  "formulaic_patterns": [
    {
      "pattern": "\\bnot only\\b[^.!?\\r\\n]*?\\bbut also\\b",
      "name": "Formulaic not only... but also",
      "penalty": 4
    },
    {
      "pattern": "\\bmake an? (investigation|examination|analysis|assessment|evaluation)\\b",
      "name": "Heavy nominalization (make an analysis/investigation)",
      "penalty": 3
    },
    {
      "pattern": "\\b(furthermore|moreover|additionally)\\b[^.!?\\r\\n]*?\\b(furthermore|moreover|additionally)\\b",
      "name": "Stacked mechanical transitions",
      "penalty": 4
    },
    {
      "pattern": "\\bplays? an? (pivotal|crucial|vital|key|essential) role in\\b",
      "name": "Cliché 'plays a vital/pivotal role in'",
      "penalty": 4
    },
    {
      "pattern": "\\b[Ii]n today's (fast-paced|rapidly changing|interconnected|dynamic) world\\b",
      "name": "Formulaic grand opening 'In today's fast-paced world'",
      "penalty": 4
    },
    {
      "pattern": "\\b[Aa]s shown in (Table|Figure) \\d+\\b",
      "name": "Formulaic table/figure presentation",
      "penalty": 3
    }
  ],
  "hedging_words": [
    "could potentially be suggested",
    "might tend to indicate",
    "seems somewhat likely",
    "appears to possibly",
    "could potentially indicate",
    "might perhaps suggest"
  ]
}
